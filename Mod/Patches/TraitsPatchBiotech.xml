<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Biotech</li>
        </mods>
        <match Class="PatchOperationAddModExtension">
            <xpath>Defs/TraitDef[defName=&quot;Delicate&quot;]</xpath>
            <value>
                <li Class="InspiredPassions.InspiredPassionsTraitEvaluationExtension">
                    <traitEvaluation>BAD</traitEvaluation>
                </li>
            </value>
        </match>
    </Operation>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Biotech</li>
        </mods>
        <match Class="PatchOperationAddModExtension">
            <xpath>Defs/TraitDef[defName=&quot;Recluse&quot;]</xpath>
            <value>
                <li Class="InspiredPassions.InspiredPassionsTraitEvaluationExtension">
                    <traitEvaluation>NEUTRAL</traitEvaluation>
                </li>
            </value>
        </match>
    </Operation>
</Patch>